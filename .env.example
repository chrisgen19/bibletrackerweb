# Local Postgres from compose.yaml (`docker compose up -d`). Port 5434 avoids clashing
# with a native Postgres on 5432.
DATABASE_URL="postgresql://bibletracker:bibletracker@localhost:5434/bibletrackerweb"

# Better Auth. Replace the secret with the output of `openssl rand -base64 32`: this
# placeholder only works locally, and production refuses it.
BETTER_AUTH_SECRET="dev-only-secret-replace-me-with-openssl-rand-base64-32"
# The app's origin. `pnpm dev` runs on port 3100.
BETTER_AUTH_URL="http://localhost:3100"

# Optional: Google sign-in. Leave both empty to hide the Google button.
# Authorised redirect URI for local development:
#   http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
